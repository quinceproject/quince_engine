    {#- Ikony modułów, których brakowało w zestawie wyżej. Lucide (licencja ISC),
        przepisane bez zmian z plików źródłowych. Rysunek Lucide ma siatkę 24 px
        i kreskę 2; przy siatce 24 kreska 2.25 daje w wyświetlanych 16 px tę samą
        grubość 1.5 co reszta zestawu. -#}
    {%- set lucide = {
        'plug':          '<path d="M12 22v-5"/><path d="M15 8V2"/><path d="M17 8a1 1 0 0 1 1 1v4a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1z"/><path d="M9 8V2"/>',
        'blocks':        '<path d="M10 22V7a1 1 0 0 0-1-1H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5a1 1 0 0 0-1-1H2"/><rect x="14" y="2" width="8" height="8" rx="1"/>',
        'cookie':        '<path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/><path d="M8.5 8.5v.01"/><path d="M16 15.5v.01"/><path d="M12 12v.01"/><path d="M11 17v.01"/><path d="M7 14v.01"/>',
