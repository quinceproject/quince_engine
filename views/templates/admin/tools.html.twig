{# System → Tools: czynności konserwacyjne silnika. Każde narzędzie ma tu
   swoją kartę `.qc-tool-card`. #}
{% extends '@Modules/quince_engine/views/templates/admin/layout.html.twig' %}
{% import '@Modules/quince_engine/views/templates/admin/_macros/icons.html.twig' as icons %}

{% trans_default_domain 'Modules.Quinceengine.Admin' %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('../modules/quince_engine/views/js/vendor/alpine.min.js') ~ qcVer }}" defer></script>
{% endblock %}

{% block quince_body %}
<div class="qc-stack">

    {# Rozmiary i formaty zdjęć, których potrzebuje motyw Quince. Przy
       instalacji silnik ustawia je sam w sklepie bez zdjęć produktów; sklep,
       który już ma zdjęcia, ustawia je tutaj. #}
    <div class="qc-card">
        <div class="qc-card-head">
            <div>
                <div class="qc-card-title">{{ 'Image sizes and formats'|trans }}</div>
                <div class="qc-card-desc">{{ 'The sizes the Quince theme shows photos in, and the file formats. Upload product photos at least 1600 px on the longer side.'|trans }}</div>
                <div class="qc-card-desc">{{ 'Product card and product page sizes follow the page width (%width% px) and the number of listing columns (%columns%) in Appearance. After changing them, set the recommended sizes again and regenerate the thumbnails.'|trans({'%width%': imagesBasis.width, '%columns%': imagesBasis.columns}) }}</div>
            </div>
            {% if images.ok %}
                <span class="qc-badge qc-badge-success">{{ 'Set'|trans }}</span>
            {% else %}
                <span class="qc-badge qc-badge-warning">{{ 'Differs'|trans }}</span>
            {% endif %}
        </div>

        <div class="qc-card-body">
            <table class="qc-table">
                <thead>
                    <tr>
                        <th>{{ 'Image type'|trans }}</th>
                        <th>{{ 'In the shop'|trans }}</th>
                        <th>{{ 'Recommended'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for typ in images.types %}
                        <tr>
                            <td>{{ typ.name }}</td>
                            <td>{{ typ.current ?? 'missing'|trans }}</td>
                            <td>{{ typ.recommended }}</td>
                            <td>{% if not typ.ok %}<span class="qc-badge qc-badge-warning">{{ 'Differs'|trans }}</span>{% endif %}</td>
                        </tr>
                    {% endfor %}
                    <tr>
                        <td>{{ 'Formats'|trans }}</td>
                        <td>{{ images.formats.current ?: 'jpg' }}</td>
                        <td>{{ images.formats.recommended }}</td>
                        <td>{% if not images.formats.ok %}<span class="qc-badge qc-badge-warning">{{ 'Differs'|trans }}</span>{% endif %}</td>
                    </tr>
                    <tr>
                        <td>{{ 'Base file'|trans }}</td>
                        <td>{{ images.base.current }}</td>
                        <td>{{ images.base.recommended }}</td>
                        <td>{% if not images.base.ok %}<span class="qc-badge qc-badge-warning">{{ 'Differs'|trans }}</span>{% endif %}</td>
                    </tr>
                </tbody>
            </table>

            {% if not images.webp %}
                <div class="qc-alert qc-alert-warning" style="margin-top:16px">
                    {{ icons.icon('info', 18, 'qc-alert-icon') }}
                    <div>{{ 'The server cannot write WebP files, so the photos stay in JPEG only.'|trans }}</div>
                </div>
            {% endif %}
        </div>

        {% if not images.ok %}
            <div class="qc-card-body" style="padding-top:0">
                <form method="post" action="{{ path('quince_tools_images_apply') }}"
                      style="display:flex; justify-content:flex-end; align-items:center; gap:16px; flex-wrap:wrap">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_tools_images_apply') }}">
                    <span class="qc-card-desc">{{ 'Afterwards regenerate the thumbnails in %link%.'|trans({'%link%': '<a href="' ~ imagesLink ~ '">' ~ ('Design → Image settings'|trans) ~ '</a>'})|raw }}</span>
                    <button type="submit" class="qc-btn qc-btn-primary">
                        {{ icons.icon('check', 14) }} {{ 'Apply recommended settings'|trans }}
                    </button>
                </form>
            </div>
        {% endif %}
    </div>

    <div class="qc-card">
        <div class="qc-card-head">
            <div>
                <div class="qc-card-title">{{ 'Icon pack'|trans }}</div>
                <div class="qc-card-desc">{{ 'Bootstrap Icons, bundled with the shop. Nothing is loaded from Google or anywhere else while a visitor browses.'|trans }}</div>
            </div>
        </div>

        <div class="qc-card-body" style="display:flex; gap:32px; flex-wrap:wrap">
            <div>
                <div class="qc-card-desc">{{ 'Installed version'|trans }}</div>
                <div class="qc-card-title">{{ iconVersion ?: '-' }}</div>
            </div>
            <div>
                <div class="qc-card-desc">{{ 'Icons available'|trans }}</div>
                <div class="qc-card-title">{{ iconCount }}</div>
            </div>
            <div>
                <div class="qc-card-desc">{{ 'Last updated'|trans }}</div>
                <div class="qc-card-title">{{ iconUpdatedAt ?: '-' }}</div>
            </div>
        </div>

        <div class="qc-card-body" style="padding-top:0">
            <div class="qc-tool-card" style="max-inline-size:420px">
                <div class="qc-tool-card-icon">{{ icons.icon('upload', 18) }}</div>
                <div class="qc-tool-card-title">{{ 'Update the icon pack'|trans }}</div>
                <div class="qc-tool-card-desc">
                    {{ 'Download a newer "bootstrap-icons" package from %link% and upload the .tgz file here. The whole set is replaced: an icon removed from the new version disappears from the picker as well.'|trans({'%link%': '<a href="https://www.npmjs.com/package/bootstrap-icons" target="_blank" rel="noopener noreferrer">npmjs.com</a>'})|raw }}
                </div>

                <form method="post" action="{{ path('quince_tools_icons_update') }}" enctype="multipart/form-data"
                      x-data="{ nazwaPliku: '' }">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_tools_icons_update') }}">
                    <div class="qc-upload">
                        <span class="qc-upload-thumb">{{ icons.icon('upload', 18) }}</span>

                        <div class="qc-upload-info">
                            <div class="qc-upload-name" x-text="nazwaPliku || '{{ 'No file chosen'|trans }}'"></div>
                            <div>{{ 'The .tgz file from the npm package, unchanged.'|trans }}</div>
                        </div>

                        <div class="qc-upload-actions">
                            <button type="button" class="qc-btn qc-btn-outline" @click="$refs.paczka.click()">
                                {{ icons.icon('upload', 14) }} {{ 'Choose a file'|trans }}
                            </button>
                            <button type="submit" class="qc-btn qc-btn-outline" x-show="nazwaPliku" x-cloak>
                                {{ icons.icon('check', 14) }} {{ 'Update'|trans }}
                            </button>
                        </div>

                        <input type="file" x-ref="paczka" hidden name="paczka" accept=".tgz,.tar.gz"
                               @change="nazwaPliku = $event.target.files.length ? $event.target.files[0].name : ''">
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>
{% endblock %}
