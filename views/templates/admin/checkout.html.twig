{% extends '@Modules/quince_engine/views/templates/admin/layout.html.twig' %}
{% import '@Modules/quince_engine/views/templates/admin/_macros/icons.html.twig' as icons %}
{% import '@Modules/quince_engine/views/templates/admin/_macros/fields.html.twig' as fields %}

{% trans_default_domain 'Modules.Quinceengine.Admin' %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('../modules/quince_engine/views/js/vendor/alpine.min.js') ~ qcVer }}" defer></script>
{% endblock %}

{% block quince_actions %}
    <button type="submit" form="quince-checkout" class="qc-btn qc-btn-primary">
        {{ icons.icon('check', 14) }} {{ 'Save changes'|trans }}
    </button>
{% endblock %}

{% block quince_body %}

{# Jeden przełącznik, bez własnej przestrzeni ustawień silnika — ekran tylko
   przyjaźniej opakowuje `PS_ONE_PAGE_CHECKOUT_ENABLED` rdzenia
   (`Quince\Engine\Settings\CheckoutSettings`). Oba warianty mają własny
   komplet szablonów w motywie; ten ekran tylko wybiera, który z nich
   zobaczy klient. #}
<form id="quince-checkout" method="post" action="{{ path('quince_checkout_save') }}"
      class="qc-stack" x-data="quinceCheckout()">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_checkout_save') }}">

    <div class="qc-alert qc-alert-info">
        {{ icons.icon('info', 18, 'qc-alert-icon') }}
        <div>{{ 'This switches the checkout every visitor sees, store-wide. It does not change how the pages themselves look — both variants already carry the same design.'|trans }}</div>
    </div>

    <div class="qc-card">
        <div class="qc-card-head">
            <div class="qc-card-title">{{ 'Checkout variant'|trans }}</div>
        </div>

        <div class="qc-card-body">
            <div class="qc-field">
                <div class="qc-seg" role="group">
                    <button type="button" class="qc-seg-btn" :class="mode === 'step' && 'is-active'"
                            @click="mode = 'step'">{{ 'Step by step'|trans }}</button>
                    <button type="button" class="qc-seg-btn" :class="mode === 'opc' && 'is-active'"
                            @click="mode = 'opc'">{{ 'One page'|trans }}</button>
                </div>
                <input type="hidden" name="MODE" :value="mode">
                <div class="qc-hint">{{ 'Step by step: address, delivery and payment follow one another, one at a time. One page: all of it sits on a single screen, with sections unlocking in place as the customer fills them in.'|trans }}</div>
            </div>
        </div>
    </div>

    <div class="qc-card">
        <div class="qc-card-head">
            <div class="qc-card-title">{{ 'Order confirmation'|trans }}</div>
        </div>

        <div class="qc-card-body">
            <div class="qc-field">
                <label class="qc-label" for="quince-checkout-hook">{{ 'Hook under order details'|trans }}</label>
                <input type="text" id="quince-checkout-hook" name="ORDER_CONFIRMATION_HOOK"
                       class="qc-field-base qc-focusable" spellcheck="false"
                       placeholder="displayWiseBlockOrderConfirmation"
                       value="{{ orderConfirmationHook }}">
                <div class="qc-hint">{{ 'A spot in the order confirmation column, right under "Order details" — the same free name you give a hook anywhere in the product page layout. Leave it empty and nothing shows there. A module (WiseBlock, or any other) registers to whatever name you type here.'|trans }}</div>
            </div>
        </div>
    </div>

    <div class="qc-card">
        <div class="qc-card-head">
            <div>
                <div class="qc-card-title">{{ 'Company details from the VAT number'|trans }}</div>
                <div class="qc-card-desc">{{ 'A "Fetch details" button in the VAT number field. The customer types the number and the company name and registered address come from the EU VIES register.'|trans }}</div>
            </div>
        </div>
        <div class="qc-card-body">
            {{ fields.toggle('VIES_LOOKUP', viesLookup, 'Show the "Fetch details" button'|trans) }}
            <div class="qc-hint">{{ 'Turned off, the button disappears and the customer types the company details by hand.'|trans }}</div>
        </div>
    </div>

    <div class="qc-card">
        <div class="qc-card-head">
            <div>
                <div class="qc-card-title">{{ 'VAT number check'|trans }}</div>
                <div class="qc-card-desc">{{ 'Before an address is saved, the shop checks the VAT number. For Poland it checks the NIP check digit, for other countries the length of the number.'|trans }}</div>
            </div>
        </div>
        <div class="qc-card-body">
            {{ fields.toggle('VAT_CHECK', vatCheck, 'Reject a wrong VAT number'|trans) }}
            <div class="qc-hint">{{ 'Turned off, the shop accepts whatever the customer types, and a mistyped number goes onto the invoice.'|trans }}</div>
        </div>
    </div>

</form>

{# Wartość wariantu w kontekście JS (tu, nie w atrybucie `x-data`): string
   z `json_encode` niesie własne cudzysłowy, które w środku atrybutu HTML
   ucinały go w połowie — Alpine dostawał `mode` jako `undefined` i żaden
   z dwóch przycisków nigdy nie wyglądał na wybrany. Ten sam wzorzec, co
   `quinceFooter()` w ustawieniach stopki: nazwana funkcja w skrypcie,
   wołana z `x-data`. #}
<script>
function quinceCheckout() {
    return {
        mode: {{ mode|json_encode|raw }},
    };
}
</script>
{% endblock %}
